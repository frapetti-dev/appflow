<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen">
        <ui:VisualElement class="backdrop" />
        <ui:VisualElement class="card">
            <ui:Label text="Paused" class="title" />
            <ui:Button name="resume" text="Resume" class="btn btn--mint stagger" />
            <ui:Button name="menu" text="Main menu" class="btn btn--coral stagger" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
